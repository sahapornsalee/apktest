<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- One of these shows the picture, depending on which player engine is running. -->
    <FrameLayout
        android:id="@+id/videoFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/exoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:use_controller="false" />

        <org.videolan.libvlc.util.VLCVideoLayout
            android:id="@+id/vlcLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.media3.ui.AspectRatioFrameLayout
            android:id="@+id/systemFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone">

            <SurfaceView
                android:id="@+id/systemSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.media3.ui.AspectRatioFrameLayout>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtGesture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="28dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/TopIcon"
                android:contentDescription="ปิด"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSeriesName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#BBFFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtSleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnEngine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_outline"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnRotate"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnResize"
                style="@style/TopIcon"
                android:contentDescription="ขนาดภาพ"
                android:src="@drawable/ic_fullscreen" />

            <ImageButton
                android:id="@+id/btnMore"
                style="@style/TopIcon"
                android:contentDescription="เมนู"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRew"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="เล่น/หยุด"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause" />

            <TextView
                android:id="@+id/btnFwd"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="40dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:progressBackgroundTint="#88FFFFFF"
                    android:progressTint="?attr/colorPrimary"
                    android:secondaryProgressTint="#CCFFFFFF"
                    android:thumbTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/txtRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSpeed"
                    style="@style/PlayerAction"
                    android:drawableTop="@drawable/ic_speed" />

                <TextView
                    android:id="@+id/btnLock"
                    style="@style/PlayerAction"
                    android:drawableTop="@drawable/ic_lock"
                    android:text="ล็อกจอ" />

                <TextView
                    android:id="@+id/btnEpisodes"
                    style="@style/PlayerAction"
                    android:drawableTop="@drawable/ic_episodes"
                    android:text="ตอน" />

                <TextView
                    android:id="@+id/btnTracks"
                    style="@style/PlayerAction"
                    android:drawableTop="@drawable/ic_subtitles"
                    android:text="เสียงและซับ" />

                <TextView
                    android:id="@+id/btnNextEp"
                    style="@style/PlayerAction"
                    android:drawableTop="@drawable/ic_next"
                    android:text="ตอนต่อไป" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Netflix-style episode picker sliding over the bottom of the video. -->
    <LinearLayout
        android:id="@+id/episodesPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F2141414"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ตอนทั้งหมด"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPanelSeason"
                style="@style/GhostButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnPanelClose"
                style="@style/OverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textSize="18sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSkip"
        style="@style/PlayButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="132dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/countdownBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="132dp"
        android:background="@drawable/bg_pill"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="320dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPlayNow"
                style="@style/PlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ เล่นเลย" />

            <Button
                android:id="@+id/btnCancelNext"
                style="@style/OverlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="ยกเลิก" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnUnlock"
        style="@style/GhostButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:text="🔓 แตะค้างเพื่อปลดล็อก"
        android:visibility="gone" />
</FrameLayout>
