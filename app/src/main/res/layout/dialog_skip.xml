<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ใส่เวลาเป็นวินาที หรือ นาที:วินาที เช่น 90 หรือ 1:30\nตั้งครั้งเดียว ใช้กับทุกตอนในเรื่องนี้"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/chkIntro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ข้ามเพลงเปิดอัตโนมัติ" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="เพลงเปิด เริ่ม " />

            <EditText
                android:id="@+id/edIntroStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0:00"
                android:inputType="time" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ถึง " />

            <EditText
                android:id="@+id/edIntroEnd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="1:30"
                android:inputType="time" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/chkOutro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ข้ามเพลงปิด (ไปตอนต่อไปทันที)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ข้าม ช่วงท้ายตอนยาว " />

            <EditText
                android:id="@+id/edOutro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="1:30"
                android:inputType="time" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/chkManual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ไม่ข้ามเอง แต่แสดงปุ่ม “ข้ามเพลงเปิด / ตอนต่อไป” ให้กด (แบบ Netflix)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="เคล็ดลับ: ระหว่างดูวิดีโอ แตะจอ แล้วกด “☰ เมนู” → “⏱ ตอนนี้ = …” เพื่อตั้งเวลาจากตำแหน่งที่กำลังดูได้เลย"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
