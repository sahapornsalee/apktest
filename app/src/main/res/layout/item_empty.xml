<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="72dp"
    android:paddingEnd="32dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_empty_icon"
        android:contentDescription="@null"
        android:padding="26dp"
        android:src="@drawable/ic_play" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="เริ่มสร้างคลังวิดีโอของคุณ"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/empty_home"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyFolder"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:text="เลือกโฟลเดอร์วิดีโอ"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_folder"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyFiles"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="เลือกไฟล์ทีละหลายไฟล์"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_movie"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorPrimary" />
</LinearLayout>
